{
  "expo": {
    "name": "TontinePlus",
    "slug": "tontine-plus",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A3D2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tontineplus.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Utilisez Face ID pour déverrouiller TontinePlus",
        "NSCameraUsageDescription": "Prenez des photos de profil",
        "NSPhotoLibraryUsageDescription": "Sélectionnez des photos de profil"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A3D2E"
      },
      "package": "com.tontineplus.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1DB954"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser TontinePlus à utiliser Face ID"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TontinePlus accède à vos photos pour les photos de profil"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ],
    "scheme": "tontineplus",
    "experiments": {
      "typedRoutes": true
    }
  }
}
