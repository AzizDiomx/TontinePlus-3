{
  "expo": {
    "name": "TontinePlus",
    "slug": "tontine-plus",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A3D2E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tontineplus.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Utilisez Face ID pour d\u00e9verrouiller TontinePlus",
        "NSCameraUsageDescription": "Prenez des photos de profil",
        "NSPhotoLibraryUsageDescription": "S\u00e9lectionnez des photos de profil"
      },
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A3D2E"
      },
      "package": "com.tontineplus.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 1,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "minSdkVersion": 24,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "tontineplus"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1DB954"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser TontinePlus \u00e0 utiliser Face ID"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "TontinePlus acc\u00e8de \u00e0 vos photos pour les photos de profil"
        }
      ]
    ],
    "scheme": "tontineplus",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09358c6d-81de-4742-b957-5a30e53f162a"
      }
    }
  }
}